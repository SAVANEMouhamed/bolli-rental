{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Bash(php artisan:*)",
            "Bash(php -v)",
            "Bash(php -m)",
            "Bash(composer install:*)",
            "Bash(composer update:*)",
            "Bash(composer dump-autoload:*)",
            "Bash(composer run:*)",
            "Bash(composer -V)",
            "Bash(vendor/bin/pint:*)",
            "Bash(vendor/bin/pest:*)",
            "Bash(npm run:*)",
            "Bash(npm ci)",
            "Bash(npm install)",
            "Bash(npx --no-install prettier:*)",
            "Bash(node -v)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git init:*)",
            "Bash(ls:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(find:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(wc:*)",
            "Bash(mkdir:*)",
            "Read(//Users/apple/Documents/bolli-rental/**)",
            "WebFetch(domain:laravel.com)",
            "WebFetch(domain:vuejs.org)",
            "WebFetch(domain:inertiajs.com)",
            "WebFetch(domain:pestphp.com)",
            "WebFetch(domain:tailwindcss.com)",
            "WebFetch(domain:owasp.org)",
            "WebFetch(domain:cheatsheetseries.owasp.org)",
            "WebFetch(domain:laravel-news.com)",
            "WebFetch(domain:www.shadcn-vue.com)",
            "WebFetch(domain:cloud.laravel.com)",
            "Skill(scope-guard)",
            "Skill(laravel-backend)",
            "Skill(eloquent-database)",
            "Skill(query-performance)",
            "Skill(vue-inertia-ui)",
            "Skill(ui-ux)",
            "Skill(security-owasp)",
            "Skill(testing-pest)",
            "Skill(dashboard-analytics)",
            "Skill(quality-gate)",
            "Skill(project-readme)",
            "Bash(docker compose up:*)",
            "Bash(docker compose ps:*)",
            "Bash(docker compose logs:*)",
            "Bash(docker compose exec:*)",
            "Bash(docker ps:*)",
            "Bash(docker exec:*)"
        ],
        "ask": [
            "Bash(composer require:*)",
            "Bash(composer remove:*)",
            "Bash(npm install:*)",
            "Bash(npm uninstall:*)",
            "Bash(npx shadcn-vue:*)",
            "Bash(git push:*)",
            "Bash(git rebase:*)",
            "Bash(git checkout:*)",
            "Bash(gh:*)",
            "Bash(php artisan migrate:fresh:*)",
            "Bash(rm:*)",
            "Bash(mv:*)",
            "Read(./storage/logs/**)",
            "Bash(docker rm:*)",
            "Bash(docker rmi:*)",
            "Bash(docker volume rm:*)",
            "Bash(docker system prune:*)",
            "Bash(docker compose down:*)"
        ],
        "deny": [
            "Read(./.env.production)",
            "Read(./.env.prod)",
            "Read(./.env.staging)",
            "Read(./.env.live)",
            "Edit(./.env.production)",
            "Edit(./.env.prod)",
            "Edit(./.env.staging)",
            "Edit(./.env.live)",
            "Read(./**/*.pem)",
            "Read(./**/*.key)",
            "Edit(./vendor/**)",
            "Edit(./node_modules/**)",
            "Edit(./public/build/**)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|clear",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
                        "timeout": 15
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-scope.sh",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
                        "timeout": 10,
                        "statusMessage": "Contrôle de sûreté de la commande..."
                    }
                ]
            },
            {
                "matcher": "Edit|Write|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write.sh",
                        "timeout": 10,
                        "statusMessage": "Contrôle secrets et fichiers sensibles..."
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.sh",
                        "timeout": 60,
                        "statusMessage": "Formatage et contrôle qualité..."
                    }
                ]
            }
        ]
    }
}
