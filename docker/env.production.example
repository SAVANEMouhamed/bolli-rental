# Modèle du fichier d'environnement de production.
#
# À copier en `.env` À CÔTÉ de docker-compose.yml sur le VPS, puis à compléter.
# Ce fichier n'est jamais commité et n'entre jamais dans l'image : la chaîne de
# déploiement ne le touche pas, sauf la ligne APP_IMAGE qu'elle réécrit.

# Écrite par le déploiement à chaque livraison. Laisser la valeur de départ.
APP_IMAGE=ghcr.io/OWNER/bolli-rental:latest
# Port publié sur la boucle locale, vers lequel le proxy 1Panel envoie le trafic.
APP_PORT=8080

APP_NAME="Bolli Rental"
APP_ENV=production
# `php artisan key:generate --show` en local, puis coller ici. Sans elle, aucune
# session ni aucun cookie chiffré ne survit à un redémarrage.
APP_KEY=
APP_DEBUG=false
APP_URL=https://exemple.votre-domaine.tld

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Les journaux partent sur la sortie d'erreur, que Docker collecte : aucun fichier
# n'est écrit dans un conteneur qui est remplacé à chaque livraison.
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bolli
DB_USERNAME=bolli
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Le proxy termine TLS : le cookie de session ne doit jamais repartir en clair.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# nginx et le proxy 1Panel sont les seuls chemins d'accès au conteneur, qui n'est
# publié que sur la boucle locale. Sans cette valeur, Laravel croit répondre en
# HTTP et fabrique des liens absolus incorrects dans les e-mails.
TRUSTED_PROXIES=*

# Envoi des accès agent et des liens de réinitialisation.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Rejoue les seeders à chaque livraison. Ils sont idempotents : ils créent le jeu
# de démonstration une fois, puis se contentent de remettre le mot de passe du
# compte de recette à la valeur publiée dans le README. Passer à false une fois
# que l'application porte de vraies données.
SEED_ON_DEPLOY=true
