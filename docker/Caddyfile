{
	frankenphp
	admin off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

{$SERVER_NAME} {
	root /app/public
	encode zstd br gzip

	# Vite signe les noms de fichiers par le contenu : un changement produit un
	# nouveau nom, le cache peut donc être définitif.
	@assets path /build/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	php_server
}
